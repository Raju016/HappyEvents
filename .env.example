# ==============================================================
# MOMENTA - EVENT MANAGEMENT PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================

# Database Connection (PostgreSQL - Neon / Supabase / Local)
DATABASE_URL="postgresql://username:password@localhost:5432/momenta_events?schema=public"

# Server Port & Mode
PORT=5000
NODE_ENV="development"

# Security & JWT Authentication
JWT_SECRET="YOUR_SUPER_SECRET_JWT_KEY_MINIMUM_32_CHARACTERS"
JWT_EXPIRES_IN="7d"

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"

# Transactional Email (Resend)
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
EMAIL_FROM="MOMENTA Events <events@yourdomain.com>"
ADMIN_EMAIL="admin@yourdomain.com"

# Client & API URLs (CORS & Redirection)
CLIENT_URL="http://localhost:5173"
API_URL="http://localhost:5000/api"

# WhatsApp Direct Integration Number (International format without + or spaces)
WHATSAPP_NUMBER="919876543210"

# Public Brand Placeholders (Customizable without code modifications)
VITE_BRAND_NAME="MOMENTA"
VITE_BRAND_SUBTITLE="EVENTS & EXPERIENCES"
VITE_CONTACT_PHONE="+91 98765 43210"
VITE_CONTACT_EMAIL="contact@momentaevents.com"
VITE_CONTACT_ADDRESS="Floor 4, Jubilee Hills, Hyderabad, India"
