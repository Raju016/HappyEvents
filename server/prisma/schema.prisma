// Prisma Schema for MOMENTA Event Management & Services Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// USER & ADMIN AUTHENTICATION
// -------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model Admin {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         AdminRole  @default(ADMIN)
  avatarUrl    String?
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]

  @@index([email])
}

model Customer {
  id          String       @id @default(uuid())
  name        String
  email       String       @unique
  phone       String
  city        String?
  avatarUrl   String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  events      Event[]
  enquiries   Enquiry[]
  reviews     Review[]

  @@index([email])
  @@index([phone])
}

// -------------------------------------------------------------
// EVENT CATEGORIES & SERVICES
// -------------------------------------------------------------

model EventCategory {
  id           String       @id @default(uuid())
  name         String       @unique
  slug         String       @unique
  tagline      String?
  description  String?
  coverImage   String?
  iconName     String?      // Lucide icon identifier
  displayOrder Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  events       Event[]
  galleryItems EventImage[]
  videos       EventVideo[]

  @@index([slug])
  @@index([displayOrder])
}

model Service {
  id             String           @id @default(uuid())
  name           String           @unique
  slug           String           @unique
  tagline        String?
  description    String
  features       String[]         @default([])
  coverImage     String?
  iconName       String?
  displayOrder   Int              @default(0)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  eventServices  EventService[]
  enquiryServices EnquiryService[]

  @@index([slug])
}

model Package {
  id           String    @id @default(uuid())
  name         String    // Essential, Premium, Luxury, Custom
  slug         String    @unique
  description  String
  priceText    String?   // e.g. "Starting from ₹1,50,000" or "Request a Quote"
  startingPrice Decimal?  @db.Decimal(12, 2)
  features     String[]  @default([])
  imageUrl     String?
  isFeatured   Boolean   @default(false)
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([slug])
}

// -------------------------------------------------------------
// EVENTS & PORTFOLIO
// -------------------------------------------------------------

model Event {
  id           String         @id @default(uuid())
  title        String
  slug         String         @unique
  tagline      String?
  description  String
  story        String?        @db.Text
  location     String
  venue        String?
  eventDate    DateTime
  guestCount   Int?
  budgetRange  String?
  isFeatured   Boolean        @default(false)
  isPublished  Boolean        @default(true)
  coverImage   String
  heroVideoUrl String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relationships
  categoryId   String
  category     EventCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  customerId   String?
  customer     Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  services     EventService[]
  images       EventImage[]
  videos       EventVideo[]
  reviews      Review[]
  testimonials Testimonial[]

  @@index([slug])
  @@index([categoryId])
  @@index([isFeatured, isPublished])
}

model EventService {
  id        String   @id @default(uuid())
  eventId   String
  serviceId String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([eventId, serviceId])
}

// -------------------------------------------------------------
// MEDIA: PHOTOS & VIDEOS (Cloudinary Metadata)
// -------------------------------------------------------------

model EventImage {
  id           String         @id @default(uuid())
  title        String?
  caption      String?
  url          String
  secureUrl    String
  publicId     String         // Cloudinary Public ID
  width        Int?
  height       Int?
  format       String?
  isFeatured   Boolean        @default(false)
  isCover      Boolean        @default(false)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  eventId      String?
  event        Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  categoryId   String?
  category     EventCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([categoryId])
  @@index([isFeatured])
}

model EventVideo {
  id           String         @id @default(uuid())
  title        String
  description  String?
  videoUrl     String
  secureUrl    String
  publicId     String         // Cloudinary Public ID
  thumbnailUrl String
  duration     Float?         // in seconds
  location     String?
  tags         String[]       @default([])
  isFeatured   Boolean        @default(false)
  isPublished  Boolean        @default(true)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  eventId      String?
  event        Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  categoryId   String?
  category     EventCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([categoryId])
  @@index([isFeatured, isPublished])
}

// -------------------------------------------------------------
// REVIEWS & TESTIMONIALS
// -------------------------------------------------------------

model Review {
  id           String    @id @default(uuid())
  customerName String
  customerPhoto String?
  rating       Int       @default(5)
  reviewText   String    @db.Text
  eventTitle   String
  location     String
  eventDate    DateTime?
  isFeatured   Boolean   @default(false)
  isPublished  Boolean   @default(false) // Needs admin approval
  isDemo       Boolean   @default(false) // Clearly marked demo data
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  eventId      String?
  event        Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([isPublished, isFeatured])
}

model Testimonial {
  id           String    @id @default(uuid())
  clientName   String
  clientRole   String?   // e.g. "Bride & Groom", "VP Marketing"
  quote        String    @db.Text
  thumbnailUrl String
  videoUrl     String
  isFeatured   Boolean   @default(false)
  isPublished  Boolean   @default(true)
  isDemo       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  eventId      String?
  event        Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([isPublished, isFeatured])
}

// -------------------------------------------------------------
// ENQUIRIES & CONTACT MESSAGES
// -------------------------------------------------------------

enum EnquiryStatus {
  NEW
  CONTACTED
  QUOTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Enquiry {
  id             String           @id @default(uuid())
  enquiryNumber  String           @unique // e.g. EVT-2026-000123
  eventType      String
  eventDate      DateTime?
  location       String
  guestCount     Int?
  budgetRange    String?
  specialNotes   String?          @db.Text
  status         EnquiryStatus    @default(NEW)
  internalNotes  String?          @db.Text
  assignedTo     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  // Contact details if customer not yet registered
  contactName    String
  contactEmail   String
  contactPhone   String

  services       EnquiryService[]

  @@index([enquiryNumber])
  @@index([status])
  @@index([createdAt])
}

model EnquiryService {
  id        String   @id @default(uuid())
  enquiryId String
  serviceId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([enquiryId, serviceId])
}

model ContactMessage {
  id          String   @id @default(uuid())
  name        String
  phone       String
  email       String
  eventType   String?
  eventDate   DateTime?
  location    String?
  message     String   @db.Text
  isRead      Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isRead])
  @@index([createdAt])
}

// -------------------------------------------------------------
// SITE SETTINGS, DYNAMIC METRICS & AUDIT LOGS
// -------------------------------------------------------------

model SiteSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model SocialLink {
  id          String   @id @default(uuid())
  platform    String   @unique // Instagram, WhatsApp, Facebook, YouTube, LinkedIn
  url         String
  iconName    String
  isActive    Boolean  @default(true)
  displayOrder Int     @default(0)
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // e.g. "EVENT_CREATED", "ENQUIRY_STATUS_UPDATED"
  entity    String   // e.g. "Event", "Enquiry"
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}
